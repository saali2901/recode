{
  "name": "recode",
  "version": "0.1.0",
  "description": "Local, AI-assisted reverse engineering and C reconstruction (Ghidra + Claude Code)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "recode": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "src/decompiler/scripts",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:ghidra": "RECODE_TEST_GHIDRA=1 vitest run test/integration/ghidra-real.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test:claude": "RECODE_TEST_CLAUDE=1 vitest run test/integration/claude-live.test.ts"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
