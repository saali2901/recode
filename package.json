{
  "name": "recode",
  "version": "0.1.0",
  "description": "Local, AI-assisted reverse engineering and C reconstruction (Ghidra + Claude Code)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "recode": "dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "src/decompiler/scripts",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:ghidra": "RECODE_TEST_GHIDRA=1 vitest run test/integration/ghidra-real.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test:claude": "RECODE_TEST_CLAUDE=1 vitest run test/integration/claude-live.test.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "dev:web": "vite",
    "test:e2e": "npm run build && RECODE_E2E=1 vitest run test/e2e",
    "hooks": "git config core.hooksPath .githooks",
    "check:docs": "vitest run test/unit/docs-sync.test.ts"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "picocolors": "^1.1.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cleanui": "github:saali2901/cleanui",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
